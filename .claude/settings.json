{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "fable[1m]",
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Skill",
      "WebSearch",
      "WebFetch",
      "mcp__aws-knowledge__*",
      "mcp__AWS_Knowledge_MCP_Server__*",
      "mcp__google-developer-knowledge__*",
      "mcp__context7__*",
      "mcp__backlog__get_*",
      "mcp__backlog__count_*",
      "mcp__drawio__get_*",
      "mcp__drawio__list_*",
      "mcp__drawio__search_shapes",
      "mcp__chrome-devtools__get_*",
      "mcp__chrome-devtools__list_*",
      "mcp__chrome-devtools__take_snapshot",
      "mcp__chrome-devtools__take_screenshot",
      "mcp__plugin_slack_slack__slack_read_*",
      "mcp__plugin_slack_slack__slack_search_*",
      "mcp__plugin_slack_slack__slack_get_*",
      "mcp__plugin_slack_slack__slack_list_*",
      "mcp__plugin_slack_slack__slack_send_message_draft"
    ],
    "ask": [
      "Bash(npm publish *)",
      "Bash(docker push *)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(gh release create *)",
      "mcp__backlog__add_*",
      "mcp__backlog__update_*",
      "mcp__backlog__delete_*",
      "mcp__chrome-devtools__evaluate_script",
      "mcp__plugin_slack_slack__slack_send_message",
      "mcp__plugin_slack_slack__slack_schedule_message"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(.envrc)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*credential*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/credentials)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.databrickscfg)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(.envrc)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/*credential*)",
      "Edit(//etc/**)",
      "Edit(//usr/**)",
      "Edit(//sys/**)",
      "Edit(//proc/**)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(doas *)",
      "Bash(chmod 777 *)",
      "Bash(chmod +s *)",
      "Bash(chown root *)",
      "Bash(mkfs*)",
      "Bash(dd if=*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ]
  },
  "autoMode": {
    "classifyAllShell": true
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true
  },
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); PCT=$(echo \"$input\" | jq -r '.context_window.used_percentage // 0' | cut -d. -f1); COST=$(echo \"$input\" | jq -r '.cost.total_cost_usd // 0'); MODEL=$(echo \"$input\" | jq -r '.model.display_name // \"?\"'); DIR=$(echo \"$input\" | jq -r '.workspace.current_dir // \".\"'); BRANCH=$(cd \"$DIR\" 2>/dev/null && git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '-'); LA=$(echo \"$input\" | jq -r '.cost.total_lines_added // 0'); LD=$(echo \"$input\" | jq -r '.cost.total_lines_removed // 0'); H5=$(echo \"$input\" | jq -r '.rate_limits.five_hour.used_percentage // 0' | cut -d. -f1); D7=$(echo \"$input\" | jq -r '.rate_limits.seven_day.used_percentage // 0' | cut -d. -f1); FB=$(bash \"$HOME/.claude/statusline-fable-usage.sh\" 2>/dev/null); R='\\033[0m'; DIM='\\033[2m'; ring() { local p=${1:-0}; local RINGS=('○' '◔' '◑' '◕' '●'); local idx=$((p / 20)); [ \"$idx\" -gt 4 ] && idx=4; [ \"$idx\" -lt 0 ] && idx=0; printf '%s' \"${RINGS[$idx]}\"; }; grad() { local p=${1:-0}; [ \"$p\" -lt 0 ] 2>/dev/null && p=0; [ \"$p\" -gt 100 ] 2>/dev/null && p=100; if [ \"$p\" -lt 50 ]; then printf '\\033[38;2;%d;200;80m' $((p * 255 / 50)); else local g=$((200 - (p - 50) * 4)); [ \"$g\" -lt 0 ] && g=0; printf '\\033[38;2;255;%d;60m' \"$g\"; fi; }; fmtring() { local lcolor=$1 label=$2 p=$3; printf \"${lcolor}%s${R} $(grad \"$p\")%s %d%%${R}\" \"$label\" \"$(ring \"$p\")\" \"$p\"; }; CTX_C='\\033[1;36m'; H5_C='\\033[1;35m'; D7_C='\\033[1;33m'; FB_C='\\033[38;5;208m'; FBSEG=''; [ -n \"$FB\" ] && FBSEG=$(printf \" ${DIM}│${R} %s\" \"$(fmtring \"$FB_C\" Fable \"$FB\")\"); printf \"\\033[1;34m%s${R} ${DIM}│${R} \\033[1;32m%s${R} ${DIM}│${R} \\033[1;33m%s${R} ${DIM}│${R} %s ${DIM}│${R} %s ${DIM}│${R} %s%s ${DIM}│${R} \\033[1;36m\\$%.2f${R} ${DIM}│${R} \\033[32m+%s${R} \\033[31m-%s${R}\" \"$MODEL\" \"$(basename \"$DIR\")\" \"$BRANCH\" \"$(fmtring \"$CTX_C\" ctx \"$PCT\")\" \"$(fmtring \"$H5_C\" 5h \"$H5\")\" \"$(fmtring \"$D7_C\" 7d \"$D7\")\" \"$FBSEG\" \"$COST\" \"$LA\" \"$LD\""
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/notchi-hook.sh\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/notchi-hook.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/notchi-hook.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/notchi-hook.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/notchi-hook.sh\""
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/notchi-hook.sh\""
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "if [ \"$(uname)\" = \"Darwin\" ]; then afplay /System/Library/Sounds/Glass.aiff & osascript -e 'display notification \"Claude Code is requesting permission\" with title \"Claude Code\" subtitle \"Awaiting confirmation\"'; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/notchi-hook.sh\""
          }
        ]
      },
      {
        "matcher": "manual",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/notchi-hook.sh\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/notchi-hook.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "if [ \"$(uname)\" = \"Darwin\" ]; then afplay /System/Library/Sounds/Hero.aiff & osascript -e 'display notification \"Task completed\" with title \"Claude Code\" subtitle \"Process finished\"'; fi",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/notchi-hook.sh\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "danishi@claude-code-config": true,
    "document-skills@anthropic-agent-skills": true,
    "slack@claude-plugins-official": true,
    "codex@openai-codex": true,
    "gaipack-ontology@gaipack-skill-marketplace": true,
    "oh-my-claudecode@omc": false
  },
  "extraKnownMarketplaces": {
    "claude-code-config": {
      "source": {
        "source": "github",
        "repo": "danishi/claude-code-config"
      }
    },
    "agent-plugins-for-aws": {
      "source": {
        "source": "github",
        "repo": "awslabs/agent-plugins"
      }
    },
    "gaipack-skill-marketplace": {
      "source": {
        "source": "github",
        "repo": "ambient-lab/gaipack-skill-marketplace"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "omc": {
      "source": {
        "source": "git",
        "url": "https://github.com/Yeachan-Heo/oh-my-claudecode.git"
      }
    }
  },
  "enabledMcpjsonServers": [
    "aws-knowledge",
    "chrome-devtools",
    "google-developer-knowledge",
    "context7",
    "drawio",
    "backlog"
  ],
  "language": "japanese",
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "tui": "fullscreen",
  "voiceEnabled": true,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "env": {
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "128000",
    "MAX_MCP_OUTPUT_TOKENS": "50000",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "ENABLE_TOOL_SEARCH": "1",
    "CLAUDE_CODE_ATTRIBUTION_HEADER": "0",
    "VISUAL": "vim"
  }
}
